# ===== 模型通道：默认 ollama（本地） / deepseek（云端备选，需填 Key 后切换） =====
MODEL_PROVIDER=ollama

# ===== DeepSeek 云端（模型 ID：deepseek-flash；OpenAI 兼容协议） =====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ===== Ollama 本地（先 ollama serve 并 ollama pull 模型） =====
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen3.5:9b

# ===== 对话参数 =====
LLM_TEMPERATURE=0.7
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_HISTORY_MESSAGES=20

# ===== 上传限制 =====
MAX_UPLOAD_BYTES=5242880

# ===== 后端（第二轮 FastAPI）=====
# API 端口（前端 Streamlit 仍用 8511）
API_PORT=8001
# 后端数据库文件（默认 data/backend.db，与第一轮 demo 库隔离）
# DB_PATH=data/backend.db
# 每用户每分钟限流阈值
RATE_LIMIT_PER_MINUTE=60
# 单条消息最大字符数
MAX_MESSAGE_LEN=4000
# 前端调用后端的地址（Streamlit 端）
BACKEND_URL=http://localhost:8001

